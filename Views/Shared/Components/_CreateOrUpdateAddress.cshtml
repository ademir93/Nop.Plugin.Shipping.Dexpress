@model DexpressAddressModel

<input class="address-id" asp-for="Id" type="hidden"/>
<div class="edit-address dexpress-edit-address">
    <div class="inputs">
        <label asp-for="FirstName" asp-postfix=":"></label>
        <input asp-for="FirstName" />
        <nop-required />
        <span asp-validation-for="FirstName"></span>
    </div>
    <div class="inputs">
        <label asp-for="LastName" asp-postfix=":"></label>
        <input asp-for="LastName" />
        <nop-required />
        <span asp-validation-for="LastName"></span>
    </div>
    <div class="inputs">
        <label asp-for="Email" asp-postfix=":"></label>
        <input asp-for="Email" />
        <nop-required />
        <span asp-validation-for="Email"></span>
    </div>
    @if (Model.CompanyEnabled)
    {
        <div class="inputs">
            <label asp-for="Company" asp-postfix=":"></label>
            <input asp-for="Company" />
            @if (Model.CompanyRequired)
            {
                <nop-required />
            }
            <span asp-validation-for="Company"></span>
        </div>
    }
    @if (Model.CountryEnabled)
    {
        <div class="inputs" style="display: none;">
            <label asp-for="CountryId" asp-postfix=":"></label>
            <select asp-for="CountryId" asp-items="Model.AvailableCountries"
                    data-trigger="country-select"
                    data-url="@(Url.RouteUrl(NopRouteNames.Ajax.GET_STATES_BY_COUNTRY_ID))"
                    data-stateprovince="#@Html.IdFor(model => model.StateProvinceId)"
                    data-loading="#states-loading-progress"
                    disabled="disabled"></select>
            <nop-required />
            <span asp-validation-for="CountryId"></span>
        </div>
    }
    
    <div class="inputs">
        <label asp-for="MunicipalityId" asp-postfix=":">@T("Plugins.Shipping.Dex.Address.Municipality")</label>
        <select asp-for="MunicipalityId">
            <option value="">@T("Plugins.Shipping.Dex.Address.SelectMunicipality")</option>
            @foreach (var municipality in Model.Municipalities)
            {
                <option value="@municipality.MId">@municipality.Name</option>
            }
        </select>
        <span asp-validation-for="MunicipalityId"></span>
    </div>
    
    <div class="inputs">
        <label asp-for="TownId" asp-postfix=":">@T("Plugins.Shipping.Dex.Address.Town")</label>
        <select asp-for="TownId"
                data-trigger="town-select"
                data-url="@Url.Action("GetStreetsByTownId", "DexpressCustomer")"
                data-street="#@Html.IdFor(model => model.StreetId)"
                data-loading="#streets-loading-progress"
                disabled="disabled">
            <option value="">@T("Plugins.Shipping.Dex.Address.SelectTown")</option>
        </select>
        <span id="towns-loading-progress" style="display: none;" class="please-wait">@T("Common.Wait")</span>
        <span asp-validation-for="TownId"></span>
    </div>

    <div class="inputs">
        <label asp-for="StreetId" asp-postfix=":">@T("Plugins.Shipping.Dex.Address.Street")</label>
        <select asp-for="StreetId" disabled="disabled">
            <option value="">@T("Plugins.Shipping.Dex.Address.SelectStreet")</option>
        </select>
        <span id="streets-loading-progress" style="display: none;" class="please-wait">@T("Common.Wait")</span>
        <span asp-validation-for="StreetId"></span>
    </div>
    
    @if (Model.CountryEnabled && Model.StateProvinceEnabled)
    {
        <div class="inputs" style="display: none;">
            <label asp-for="StateProvinceId" asp-postfix=":"></label>
            <select asp-for="StateProvinceId" asp-items="Model.AvailableStates"
                    data-trigger="state-select" disabled="disabled">
            </select>
            <span id="states-loading-progress" style="display: none;" class="please-wait">@T("Common.Wait")</span>
            <span asp-validation-for="StateProvinceId"></span>
        </div>
    }
    @if (Model.CountyEnabled)
    {
        <div class="inputs">
            <label asp-for="County" asp-postfix=":"></label>
            <input asp-for="County" />
            @if (Model.CountyRequired)
            {
                <nop-required />
            }
            <span asp-validation-for="County"></span>
        </div>
    }
    
    @if (Model.CityEnabled)
    {
        <div class="inputs">
            <label asp-for="City" asp-postfix=":"></label>
            <input asp-for="City" />
            @if (Model.CityRequired)
            {
                <nop-required />
            }
            <span asp-validation-for="City"></span>
        </div>
    }
    @if (Model.StreetAddressEnabled)
    {
        <div class="inputs">
            <label asp-for="Address1" asp-postfix=":"></label>
            <input asp-for="Address1" />
            @if (Model.StreetAddressRequired)
            {
                <nop-required />
            }
            <span asp-validation-for="Address1"></span>
        </div>
    }
    @if (Model.StreetAddress2Enabled)
    {
        <div class="inputs">
            <label asp-for="Address2" asp-postfix=":"></label>
            <input asp-for="Address2" />
            @if (Model.StreetAddress2Required)
            {
                <nop-required />
            }
            <span asp-validation-for="Address2"></span>
        </div>
    }
    @if (Model.ZipPostalCodeEnabled)
    {
        <div class="inputs">
            <label asp-for="ZipPostalCode" asp-postfix=":"></label>
            <input asp-for="ZipPostalCode" />
            @if (Model.ZipPostalCodeRequired)
            {
                <nop-required />
            }
            <span asp-validation-for="ZipPostalCode"></span>
        </div>
    }
    @if (Model.PhoneEnabled)
    {
        <div class="inputs">
            <label asp-for="PhoneNumber" asp-postfix=":"></label>
            <input asp-for="PhoneNumber" />
            @if (Model.PhoneRequired)
            {
                <nop-required />
            }
            <span asp-validation-for="PhoneNumber"></span>
        </div>
    }
    @if (Model.FaxEnabled)
    {
        <div class="inputs">
            <label asp-for="FaxNumber" asp-postfix=":"></label>
            <input asp-for="FaxNumber" />
            @if (Model.FaxRequired)
            {
                <nop-required />
            }
            <span asp-validation-for="FaxNumber"></span>
        </div>
    }
    <input type="hidden" name="Address.CountryId" value="198" />
    <input type="hidden" name="Address.StateProvinceId" value="1433" />
    @if (Model.CustomAddressAttributes.Count > 0)
    {
        @await Html.PartialAsync("_AddressAttributes", Model.CustomAddressAttributes)
    }
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.AddressBottom, additionalData = Model })
    <script>
        $(function() {
            // Municipality → Town
            $("#@Html.IdFor(model => model.MunicipalityId)").change(function(){
                var selectedItem = $(this).val();
                var ddlTowns = $("#@Html.IdFor(model => model.TownId)");
                var ddlStreets = $("#@Html.IdFor(model => model.StreetId)");

                // Reset and disable dependent dropdowns
                ddlTowns.html('<option value="">@T("Address.SelectTown")</option>');
                ddlStreets.html('<option value="">@T("Address.SelectStreet")</option>');
                ddlStreets.prop('disabled', true);

                if (selectedItem) {
                    $.ajax({
                        cache: false,
                        type: "POST",
                        url: "@(Url.Action("GetTownsByMunicipalityId", "DexpressCustomer"))",
                        data: {
                            "municipalityId": selectedItem
                        },
                        success: function (data, textStatus, jqXHR) {
                            ddlTowns.html('<option value="">@T("Address.SelectTown")</option>');
                            $.each(data, function(id, option) {
                                ddlTowns.append($('<option></option>').val(option.id).html(option.name));
                            });
                            ddlTowns.prop('disabled', false);
                        },
                        error: function (jqXHR, textStatus, errorThrown) {
                            $("#getTownsByMunicipalityIdAlert").trigger("click");
                        }
                    });
                } else {
                    ddlTowns.prop('disabled', true);
                }
            });

            // Town → Street
            $("#@Html.IdFor(model => model.TownId)").change(function(){
                var selectedItem = $(this).val();
                var ddlStreets = $("#@Html.IdFor(model => model.StreetId)");

                ddlStreets.html('<option value="">@T("Address.SelectStreet")</option>');

                if (selectedItem) {
                    $.ajax({
                        cache: false,
                        type: "POST",
                        url: "@(Url.Action("GetStreetsByTownId", "DexpressCustomer"))",
                        data: {
                            "townId": selectedItem
                        },
                        success: function (data, textStatus, jqXHR) {
                            ddlStreets.html('<option value="">@T("Address.SelectStreet")</option>');
                            $.each(data, function(id, option) {
                                ddlStreets.append($('<option></option>').val(option.id).html(option.name));
                            });
                            ddlStreets.prop('disabled', false);
                        },
                        error: function (jqXHR, textStatus, errorThrown) {
                            $("#getStreetsByTownIdAlert").trigger("click");
                        }
                    });
                } else {
                    ddlStreets.prop('disabled', true);
                }
            });
        });
    </script>
</div>
